# ---- existing
ANYTHINGLLM_JWT_SECRET=change-me
VLLM_API_KEY=change-me
# ANYTHINGLLM_BIND=100.x.y.z     # the box's Tailscale IP
# ANYTHINGLLM_TAG=latest
PUID=1000
PGID=1000

# ---- SharePoint sync (Graph API)
SP_TENANT_ID=00000000-0000-0000-0000-000000000000
SP_CLIENT_ID=00000000-0000-0000-0000-000000000000
SP_HOSTNAME=yourtenant.sharepoint.com
SP_SITE_PATH=/sites/CaseFilesTest
SP_DRIVE_NAME=Documents          # the library; "Documents" is the default "Shared Documents" library
SP_CASES_ROOT=Cases              # folder that holds one subfolder per case ("" = library root)

# Generated in AnythingLLM: Settings > Developer API
ANYTHINGLLM_API_KEY=

SYNC_INTERVAL=300
SKIP_SUBFOLDERS=Drafts
OUTBOX_SUBFOLDERS=Drafts,Transcripts,Billing
MAX_FILE_MB=100
SYNC_LOG_NAMES=false             # true only on the test box

# Host paths (put these on the encrypted data volume in production)
SYNC_CERTS_DIR=./sync/certs
SYNC_STATE_DIR=/srv/llm/sync-state
OUTBOX_DIR=/srv/llm/outbox
